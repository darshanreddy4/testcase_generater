# --- LLM Provider (OpenAI-compatible) ---
# Works with OpenAI, Azure OpenAI (via base URL), or any OpenAI-compatible gateway.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8000
# Use the OpenAI SDK's native structured-output parsing when available (more reliable
# than prompt+regex JSON extraction). Automatically falls back if the model/provider
# doesn't support it.
USE_NATIVE_STRUCTURED_OUTPUTS=true

# --- Pipeline behavior ---
# Where per-stage checkpoints are written so an interrupted run can resume instead of
# starting over.
CHECKPOINT_DIR=output/.checkpoints
# Similarity ratio (0-1) above which a newly generated test case is considered a
# duplicate of an existing one and dropped in favor of net-new coverage.
DEDUP_SIMILARITY_THRESHOLD=0.88

# --- Jira Integration (optional) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# --- Existing Artifacts (optional local knowledge base) ---
# CSV files used for impact/regression analysis against existing test cases & defects.
EXISTING_TEST_CASES_CSV=data/sample_existing_test_cases.csv
EXISTING_DEFECTS_CSV=data/sample_defects.csv
