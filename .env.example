# --- LLM Provider (OpenAI-compatible) ---
# Works with OpenAI, Azure OpenAI (via base URL), or any OpenAI-compatible gateway.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8000

# --- Jira Integration (optional) ---
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=you@yourcompany.com
JIRA_API_TOKEN=your-jira-api-token

# --- Existing Artifacts (optional local knowledge base) ---
# CSV files used for impact/regression analysis against existing test cases & defects.
EXISTING_TEST_CASES_CSV=data/sample_existing_test_cases.csv
EXISTING_DEFECTS_CSV=data/sample_defects.csv
